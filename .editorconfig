# Editor settings for every project made from this template.
# Docs: https://editorconfig.org (Positron/VS Code may need the EditorConfig extension).
# CI checks trailing whitespace separately, so it is caught even if an editor ignores this file.

# Stop searching parent folders for other .editorconfig files.
root = true

# Defaults for all files.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: two trailing spaces are a line break, so keep them.
[*.md]
trim_trailing_whitespace = false

# Generated by pixi; never edited by hand, so editors should leave it alone.
[pixi.lock]
insert_final_newline = unset
trim_trailing_whitespace = unset

# Indentation:
# [{Snakefile,*.smk,*.py,*.nf,*.config}]
# indent_style = space
# indent_size = 4
#
# [*.{yml,yaml,toml}]
# indent_style = space
# indent_size = 2
