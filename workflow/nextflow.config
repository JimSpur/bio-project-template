// Nextflow settings for the hello-world workflow (workflow/main.nf).
// Combine profiles with commas, for example: -profile test,docker

// Default parameter values. Override on the command line with --greeting '...'.
params {
    greeting = 'Hello World'
}

// Top folder for workflow outputs (the output { } block in main.nf adds
// its own subfolder). Override with -o / -output-dir.
outputDir = 'results/nextflow'

// Image for every process. Only used when a container profile below is on.
// Images must exist on the machine before a run.
// Build template image from repo root:
// docker build -t --platform linux/amd64 bio-project-template:dev containers/
process {
    container = 'bio-project-template:dev'
}

profiles {

    // Small, fixed resources so the test runs on a laptop or a CI runner.
    test {
        process {
            resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
        }
    }

    // Docker with the host's own architecture (arm64 on the Macs, amd64 on the PC).
    docker {
        docker.enabled = true
    }

    // Docker forced to amd64, as on HPC and CI (runs under Rosetta on the Macs).
    docker_amd64 {
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'
    }

    // Apptainer, for the Ubuntu PC (Apptainer does not run on macOS).
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
}
